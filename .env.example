# Optional. GovGuide works without an LLM and never uses one as a factual source.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required only for the SAM.gov Assistance Listings connector.
SAM_API_KEY=

# Ingestion guardrails.
GOVGUIDE_USER_AGENT=GovGuide/1.0 (contact: your-email@example.com)
GOVGUIDE_CRAWL_LIMIT=40
GOVGUIDE_CRAWL_DELAY_MS=10000

# Optional override. Defaults to data/govguide.db.
GOVGUIDE_DB_PATH=
